   return static_cast<D3D11ResourceCommon *>(pResource)->texture();
 }
 
+template <typename IResource> class MTLD3D11InteropSurface final : public IDXMTInteropSurface {
+public:
+  MTLD3D11InteropSurface(IResource *pResource, MTLD3D11Device *pDevice) : resource_(pResource), device_(pDevice) {}
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppvObject) final {
+    return resource_->QueryInterface(riid, ppvObject);
+  }
+
+  ULONG STDMETHODCALLTYPE AddRef() final { return resource_->AddRef(); }
+
+  ULONG STDMETHODCALLTYPE Release() final { return resource_->Release(); }
+
+  HRESULT STDMETHODCALLTYPE GetDevice(IDXMTInteropDevice **ppDevice) final {
+    if (!ppDevice)
+      return E_POINTER;
+    return device_->QueryInterface(__uuidof(IDXMTInteropDevice), (void **)ppDevice);
+  }
+
+  HRESULT STDMETHODCALLTYPE GetMetalTextureInfo(DXMT_INTEROP_TEXTURE_INFO *pInfo) final {
+    if (!pInfo)
+      return E_POINTER;
+    auto texture = resource_->texture();
+    if (!texture || !texture->current())
+      return E_FAIL;
+    D3D11_RESOURCE_DIMENSION dim;
+    resource_->GetType(&dim);
+    if (dim != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+      return E_NOTIMPL;
+    D3D11_TEXTURE2D_DESC desc;
+    resource_->GetDesc(&desc);
+    pInfo->Texture = texture->current()->texture().handle;
+    pInfo->Device = device_->GetMTLDevice().handle;
+    pInfo->PixelFormat = texture->pixelFormat();
+    pInfo->TextureType = texture->textureType();
+    pInfo->Usage = texture->usage();
+    pInfo->Width = texture->width();
+    pInfo->Height = texture->height();
+    pInfo->Depth = texture->depth();
+    pInfo->ArraySize = desc.ArraySize;
+    pInfo->MipLevels = desc.MipLevels;
+    pInfo->SampleCount = texture->sampleCount();
+    pInfo->D3D11Usage = desc.Usage;
+    return pInfo->Texture ? S_OK : E_FAIL;
+  }
+
+private:
+  IResource *resource_;
+  MTLD3D11Device *device_;
+};
+
